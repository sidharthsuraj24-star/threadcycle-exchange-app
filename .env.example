# Required for any server start. Generate a fresh random SESSION_SECRET (at least 32 characters).
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret-generated-outside-this-repository
NODE_ENV=development
PORT=3000
# Optional: set to true to insert clearly marked, non-interactive illustrative demo listings.
SEED_DEMOS=true
# Optional: exact deployed HTTPS origin, e.g. https://your-project.vercel.app
APP_ORIGIN=
# Optional proxy setup; configure one trusted proxy hop on Vercel.
TRUST_PROXY=1
# Courier demonstration uses a deterministic local mock; it needs no credentials.
COURIER_MODE=demo
LIVE_SHIPMENTS=false
